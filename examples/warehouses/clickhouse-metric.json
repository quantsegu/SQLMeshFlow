{
  "source": {
    "table": "raw_vault.sat_order",
    "business_key": "ORDER_HK",
    "load_timestamp": "LOAD_DTS",
    "time_column": "EFFECTIVE_AT",
    "columns": {
      "ORDER_HK": "BLOB",
      "LOAD_DTS": "TIMESTAMPTZ",
      "EFFECTIVE_AT": "TIMESTAMPTZ",
      "QUANTITY": "DOUBLE",
      "UNIT_PRICE": "DOUBLE",
      "DISCOUNT_RATE": "DOUBLE",
      "REGION": "VARCHAR"
    }
  },
  "metric": {
    "name": "net_sales",
    "calculation": "QUANTITY * UNIT_PRICE * (1 - COALESCE(DISCOUNT_RATE, 0))",
    "aggregation": "sum"
  },
  "group_by": [
    "REGION"
  ],
  "warehouse": {
    "type": "clickhouse",
    "connection": {
      "host": {
        "env": "CLICKHOUSE_HOST"
      },
      "username": {
        "env": "CLICKHOUSE_USER"
      },
      "password": {
        "env": "CLICKHOUSE_PASSWORD"
      },
      "secure": true,
      "port": 8443
    }
  },
  "target": {
    "schema": "analytics",
    "table": "net_sales",
    "grouped_table": "net_sales_by_region"
  }
}
